# Localhost testnet UI backend. Never add NEXT_PUBLIC_ to secrets.
ANTHROPIC_API_KEY=
WALLET_INTENT_MODEL=claude-opus-5-5
# Legacy single-wallet setup. Chat no longer reads this: each account's agent address comes from
# its own account record. Safe to leave blank.
SUI_ADDRESS=
# Same token and private directory as the signer.
SUI_SIGNER_TOKEN=REPLACE_WITH_SAME_RANDOM_TOKEN
SUI_SIGNER_STATE_DIR=/absolute/private/signer-state
SUI_SIGNER_PORT=38435
# Optional trusted contacts; each value must be a full Sui address.
WALLET_CONTACTS_JSON={}
# REQUIRED for account creation: the published vault package every new account's vault is created
# from. Accounts are only accepted if their vault comes from this package.
SUI_VAULT_PACKAGE_ID=
# Optional overrides. Omit to use repository defaults; do not set blank values.
# SUI_VAULT_ID and SUI_VAULT_AGENT_CAP_ID are no longer used: each account has its own vault.
# SUI_POOL_PACKAGE_ID=<testnet-pool-package-id>
# SUI_POOL_ID=<testnet-pool-object-id>
# Optional owner CLI keystore for approval cards; never the agent's private key.
# SUI_KEYSTORE_PATH=/absolute/path/to/sui.keystore

# Google sign-in. Create a Web application OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Must match the redirect URI registered with Google.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Chat requests spend the ANTHROPIC_API_KEY above. Each account gets this many per UTC day, and
# the whole app is capped by the global figure. Defaults: 50 and 1000.
# CHAT_DAILY_LIMIT=50
# CHAT_GLOBAL_DAILY_LIMIT=1000
