# Localhost testnet UI backend. Never add NEXT_PUBLIC_ to secrets.
ANTHROPIC_API_KEY=
WALLET_INTENT_MODEL=claude-opus-5-5
# Public address of the existing agent wallet that owns the configured AgentCap.
SUI_ADDRESS=
# Same token and private directory as the signer.
SUI_SIGNER_TOKEN=REPLACE_WITH_SAME_RANDOM_TOKEN
SUI_SIGNER_STATE_DIR=/absolute/private/signer-state
SUI_SIGNER_PORT=38435
# Optional trusted contacts; each value must be a full Sui address.
WALLET_CONTACTS_JSON={}
# Optional overrides. Omit to use repository defaults; do not set blank values.
# SUI_VAULT_PACKAGE_ID=<deployed-package-id>
# SUI_VAULT_ID=<vault-object-id>
# SUI_VAULT_AGENT_CAP_ID=<agent-owned-capability-id>
# SUI_POOL_PACKAGE_ID=<testnet-pool-package-id>
# SUI_POOL_ID=<testnet-pool-object-id>
# Optional owner CLI keystore for approval cards; never the agent's private key.
# SUI_KEYSTORE_PATH=/absolute/path/to/sui.keystore
