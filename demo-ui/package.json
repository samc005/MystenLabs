{
  "name": "demo-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Browser demo of the Sui testnet wallet: create a wallet, fund it, check balances, send SUI.",
  "scripts": {
    "dev": "\"${npm_node_execpath:-node}\" node_modules/next/dist/bin/next dev -H 127.0.0.1",
    "build": "\"${npm_node_execpath:-node}\" node_modules/next/dist/bin/next build",
    "start": "\"${npm_node_execpath:-node}\" node_modules/next/dist/bin/next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "passkeys:recover": "\"${npm_node_execpath:-node}\" scripts/recover-passkeys.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@mysten/sui": "2.35.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
