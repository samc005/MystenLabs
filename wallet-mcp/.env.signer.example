# Private signer configuration. npm run signer loads this file explicitly.
SUI_NETWORK=testnet
# Existing agent wallet JSON (network/address/secretKey); private file mode 0600.
# This wallet must own the vault's AgentCap. Do not create an unrelated replacement.
SUI_WALLET_FILE=
# Alternative to SUI_WALLET_FILE; only set in this signer file:
# SUI_SECRET_KEY=<existing-testnet-private-key>
SUI_SIGNER_TOKEN=REPLACE_WITH_SAME_RANDOM_TOKEN
SUI_SIGNER_STATE_DIR=/absolute/private/signer-state
SUI_SIGNER_PORT=38435
